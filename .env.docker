PP_NAME=NotificationService
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=notification_service
DB_USERNAME=notification_user
DB_PASSWORD=secret123

QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=notification_user
RABBITMQ_PASSWORD=secret123
RABBITMQ_QUEUE=default

CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Префиксы для Redis ключей
REDIS_DUPLICATE_PREFIX=notification:duplicate
REDIS_RATE_LIMIT_PREFIX=rate_limit
REDIS_CACHE_PREFIX=cache

MAIL_MAILER=log
